# -- Federation Game LLM Provider Keys --
# Copy this file to .env and fill in your actual values.
# NEVER commit .env or any file with real API keys.

# -- NVIDIA NIM --
# Comma-separated list of NIM API keys
NIM_API_KEYS=
# Or individual keys (NIM_API_KEY_1 through NIM_API_KEY_8)
NIM_API_KEY_1=
NIM_API_KEY_2=
NIM_API_KEY_3=
NIM_API_KEY_4=
NIM_API_KEY_5=
NIM_API_KEY_6=
NIM_API_KEY_7=
NIM_API_KEY_8=

# -- Ollama (Local GPU via Tailscale) --
OLLAMA_BASE_URL=http://100.95.92.117:11434/v1
# 3B model is the default for routine NPC thought generation (safe for desktop)
OLLAMA_MODEL=qwen2.5-coder:3b-instruct-q4_K_M
OLLAMA_TIMEOUT=45
# 7B model only for high-significance events (heavy tier) -- keep_alive auto-unloads
# DISABLED by default. Set OLLAMA_HEAVY_ENABLED=1 to allow heavy calls.
OLLAMA_HEAVY_MODEL=qwen2.5-coder:7b
OLLAMA_HEAVY_KEEP_ALIVE=3m
OLLAMA_HEAVY_ENABLED=
# Backpressure: max 1 active call, max 3 queued, cooldown 60s on 500/client-abort
OLLAMA_MAX_ACTIVE=1
OLLAMA_MAX_QUEUE=3
OLLAMA_COOLDOWN_SECONDS=60
# Cache /api/tags response for N seconds (stops repeated polling)
OLLAMA_TAGS_CACHE_TTL=60

# -- Cloudflare Workers AI --
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_MODEL=@cf/meta/llama-3.1-8b-instruct
CF_TIMEOUT=15

# -- Together AI --
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=meta-llama/Llama-3-8b-chat-hf
TOGETHER_TIMEOUT=20

# -- Google Gemini --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=20
# Comma-separated task classes allowed to use paid Gemini fallback.
# For budget safety, keep this to assistant unless you intentionally want NPC/background usage.
GEMINI_ALLOWED_TASKS=assistant
# Optional hard stops (0 disables the limit)
GEMINI_MAX_CALLS_PER_DAY=25
GEMINI_MAX_CALLS_PER_MONTH=200
GEMINI_MONTHLY_USD_CAP=10
# Alert at 50%, 80%, and 100% of GEMINI_MONTHLY_USD_CAP via NOTIFICATION_URLS.
GEMINI_NOTIFY_THRESHOLDS=0.5,0.8,1.0
GEMINI_NOTIFY_INTERVAL_SECONDS=3600

# -- Grok/xAI --
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini
GROK_TIMEOUT=25

# -- OpenRouter --
OPENROUTER_API_KEY=

# -- Notifications (Apprise format) --
# Telegram: tgram://{bot_token}/{chat_id}/
# Discord: discord://{webhook_id}/{webhook_token}/
# See https://github.com/caronc/apprise for all supported schemes
NOTIFICATION_URLS=

# -- Redis --
REDIS_URL=redis://redis:6379/0
