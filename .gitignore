# ===== KILO LOCAL CONFIG - NEVER COMMIT =====
# .kilo/kilo.json is editor-local LLM provider config that historically
# contained live NVIDIA API keys. Live keys must never reach the repo.
# The exact file path is pinned (more specific than a bare `.kilo/`) so
# partner subdirectories under `.kilo/` (e.g. plans/, settings.json) can
# still be tracked if needed.
.kilo/kilo.json

# Auto-backup files generated by kilo editor or other workflow tools.
# These are timestamp snapshots of edit-time backups — never commit.
*.backup-*
*.bak.[0-9]*

