[
  {
    "id": "deploy-federation",
    "execute-command": "/usr/local/bin/deploy.sh",
    "command-working-directory": "/docker/federation-game",
    "pass-arguments-to-command": [],
    "pass-environment-to-command": [],
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "value",
            "value": "refs/heads/main",
            "parameter": {
              "source": "payload",
              "name": "ref"
            }
          }
        }
      ]
    },
    "response-message": "{\"status\":\"deploying\",\"message\":\"Push to main detected, deploying Federation...\"}",
    "response-content-type": "application/json"
  }
]
